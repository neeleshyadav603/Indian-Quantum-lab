/* Reading Progress Bar */
.reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: transparent;
    z-index: 1001;
    pointer-events: none;
}

.reading-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-accent) 0%, var(--color-secondary-accent) 100%);
    box-shadow: 0 0 10px rgba(var(--color-accent-rgb), 0.5);
    transition: width 0.1s linear;
}

/* Blog Hero */
.blog-hero {
    padding: calc(72px + var(--space-16)) 0 var(--space-10);
    text-align: center;
    background: linear-gradient(180deg, rgba(var(--color-accent-rgb), 0.05) 0%, transparent 100%);
}

.blog-hero h1 {
    font-size: var(--text-5xl);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
}

.blog-hero p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 640px;
    margin: 0 auto;
}

/* Blog Controls */
.blog-controls {
    position: sticky;
    top: 72px;
    background-color: var(--bg-body);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    z-index: 100;
    padding: var(--space-4) 0;
}

.blog-controls-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
}

.blog-search-wrapper {
    position: relative;
    max-width: 600px;
    width: 100%;
}

.search-icon {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    color: var(--text-tertiary);
    pointer-events: none;
}

.blog-search-input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    padding-left: calc(var(--space-4) + 28px);
    padding-right: calc(var(--space-4) + 28px);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    color: var(--text-primary);
    transition: all var(--transition-fast);
}

.blog-search-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(var(--color-accent-rgb), 0.15);
}

.blog-search-input::placeholder {
    color: var(--text-tertiary);
}

.search-clear {
    position: absolute;
    right: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--text-tertiary);
    font-size: var(--text-xl);
    cursor: pointer;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
}

.search-clear:hover {
    background-color: var(--bg-surface-hover);
    color: var(--text-primary);
}

.blog-filters {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: var(--space-1);
    scrollbar-width: none;
}

.blog-filters::-webkit-scrollbar {
    display: none;
}

.filter-btn {
    padding: var(--space-2) var(--space-4);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all var(--transition-fast);
}

.filter-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
}

.filter-btn.active {
    background-color: var(--color-accent);
    color: var(--text-inverse);
    border-color: var(--color-accent);
}

.blog-results-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-color);
    font-size: var(--text-sm);
    color: var(--text-secondary);
}

.blog-sort {
    padding: var(--space-1) var(--space-3);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: var(--text-sm);
    cursor: pointer;
}

/* Blog Grid */
.blog-section {
    padding: var(--space-10) 0 var(--space-16);
}

.blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
}

/* Blog Card */
.blog-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all var(--transition-normal);
    text-decoration: none;
    color: inherit;
}

.blog-card:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--color-accent-rgb), 0.3);
    box-shadow: var(--shadow-card-hover), 0 0 30px rgba(var(--color-accent-rgb), 0.1);
}

.blog-card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, rgba(var(--color-accent-rgb), 0.1), rgba(var(--color-secondary-accent-rgb), 0.1));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-5xl);
    position: relative;
    overflow: hidden;
}

.blog-card-image::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: 
        linear-gradient(rgba(var(--color-accent-rgb), 0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(var(--color-accent-rgb), 0.08) 1px, transparent 1px);
    background-size: 20px 20px;
}

.blog-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
}

.blog-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    flex-wrap: wrap;
}

.blog-card-category {
    color: var(--color-accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.blog-card-title {
    font-size: var(--text-xl);
    font-weight: 700;
    margin: 0;
    color: var(--text-primary);
    line-height: var(--leading-tight);
}

.blog-card:hover .blog-card-title {
    color: var(--color-accent);
}

.blog-card-excerpt {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
}

.blog-card-author {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-color);
    margin-top: var(--space-3);
}

.blog-card-author-avatar {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-accent), var(--color-secondary-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-inverse);
    font-size: var(--text-xs);
    font-weight: 700;
}

.blog-card-author-name {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-weight: 500;
}

.blog-card-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-accent);
    font-weight: 600;
    font-size: var(--text-sm);
    transition: gap var(--transition-fast);
}

.blog-card:hover .blog-card-link {
    gap: var(--space-2);
}

/* Tag Pills */
.tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.15em 0.6em;
    font-size: var(--text-xs);
    font-weight: 500;
    background-color: rgba(var(--color-accent-rgb), 0.08);
    color: var(--color-accent);
    border: 1px solid rgba(var(--color-accent-rgb), 0.2);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
}

.tag-pill-basics { background-color: rgba(0, 255, 136, 0.08); color: #00ff88; border-color: rgba(0, 255, 136, 0.2); }
.tag-pill-gates { background-color: rgba(124, 58, 237, 0.08); color: #a78bfa; border-color: rgba(124, 58, 237, 0.2); }
.tag-pill-algorithms { background-color: rgba(0, 212, 255, 0.08); color: #00d4ff; border-color: rgba(0, 212, 255, 0.2); }
.tag-pill-hardware { background-color: rgba(255, 170, 0, 0.08); color: #ffaa00; border-color: rgba(255, 170, 0, 0.2); }
.tag-pill-research { background-color: rgba(255, 68, 68, 0.08); color: #ff6b6b; border-color: rgba(255, 68, 68, 0.2); }
.tag-pill-news { background-color: rgba(168, 85, 247, 0.08); color: #c084fc; border-color: rgba(168, 85, 247, 0.2); }

/* Search highlight */
mark {
    background-color: rgba(var(--color-accent-rgb), 0.25);
    color: var(--color-accent);
    padding: 0 0.1em;
    border-radius: 2px;
}

/* Pagination */
.blog-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-12);
}

.pagination-btn {
    padding: var(--space-2) var(--space-4);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    min-width: 40px;
}

.pagination-btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
}

.pagination-btn.active {
    background-color: var(--color-accent);
    color: var(--text-inverse);
    border-color: var(--color-accent);
}

.pagination-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
}

/* No Results */
.blog-no-results {
    text-align: center;
    padding: var(--space-16) var(--space-8);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
}

.no-results-icon {
    font-size: var(--text-6xl);
    margin-bottom: var(--space-4);
    opacity: 0.5;
}

.blog-no-results h3 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
}

.blog-no-results p {
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
}

/* Newsletter */
.blog-newsletter {
    padding: var(--space-16) 0;
    background: linear-gradient(135deg, rgba(var(--color-accent-rgb), 0.03), rgba(var(--color-secondary-accent-rgb), 0.03));
    border-top: 1px solid var(--border-color);
}

.newsletter-card {
    text-align: center;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-8);
    box-shadow: var(--shadow-lg);
}

.newsletter-card h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-3);
}

.newsletter-card p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
}

/* ==================== BLOG POST STYLES ==================== */

.blog-post {
    padding-top: 72px;
}

.post-header {
    padding: var(--space-12) 0 var(--space-8);
    border-bottom: 1px solid var(--border-color);
    background: linear-gradient(180deg, rgba(var(--color-accent-rgb), 0.03) 0%, transparent 100%);
}

.post-back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
    transition: color var(--transition-fast);
}

.post-back:hover {
    color: var(--color-accent);
}

.post-category {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: var(--font-mono);
    margin-bottom: var(--space-4);
}

.post-title {
    font-size: var(--text-5xl);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-6) 0;
    color: var(--text-primary);
}

.post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
    margin-bottom: var(--space-5);
}

.post-author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
}

.author-avatar {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-accent), var(--color-secondary-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-inverse);
    font-weight: 700;
    font-size: var(--text-base);
}

.author-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: var(--text-base);
}

.author-role {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
}

.post-meta-details {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    flex-wrap: wrap;
}

.meta-separator {
    color: var(--text-tertiary);
}

.post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
}

/* Post Layout */
.post-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--space-12);
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-12) var(--container-padding);
}

.post-content-wrapper {
    min-width: 0;
}

/* Post Content Typography */
.post-content {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 70ch;
}

.post-content h2 {
    font-size: var(--text-3xl);
    color: var(--text-primary);
    margin-top: var(--space-12);
    margin-bottom: var(--space-5);
    scroll-margin-top: 100px;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-color);
}

.post-content h3 {
    font-size: var(--text-2xl);
    color: var(--text-primary);
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    scroll-margin-top: 100px;
}

.post-content p {
    margin-bottom: var(--space-5);
    color: var(--text-secondary);
}

.post-content strong {
    color: var(--text-primary);
    font-weight: 600;
}

.post-content em {
    color: var(--color-accent);
    font-style: italic;
}

.post-content a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
}

.post-content a:hover {
    color: var(--color-accent-hover);
}

.post-content ul, .post-content ol {
    padding-left: var(--space-6);
    margin-bottom: var(--space-5);
}

.post-content li {
    margin-bottom: var(--space-2);
    color: var(--text-secondary);
}

.post-content ul li {
    list-style: disc;
}

.post-content ol li {
    list-style: decimal;
}

.post-content blockquote {
    border-left: 4px solid var(--color-accent);
    background-color: var(--bg-surface);
    padding: var(--space-4) var(--space-6);
    margin: var(--space-6) 0;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--text-primary);
}

.post-content code {
    background-color: var(--code-bg);
    color: var(--code-text);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    font-size: 0.88em;
    font-family: var(--font-mono);
}

.post-content pre {
    background-color: #1e1e3f !important;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: var(--space-5) !important;
    overflow-x: auto;
    margin: var(--space-6) 0;
    position: relative;
}

.post-content pre code {
    background: transparent;
    color: #e6e6e6;
    padding: 0;
    font-size: 0.9em;
    line-height: 1.6;
}

.code-copy-btn {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    padding: var(--space-1) var(--space-2);
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-sm);
    color: #fff;
    font-size: var(--text-xs);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--transition-fast);
}

.post-content pre:hover .code-copy-btn {
    opacity: 1;
}

.code-copy-btn:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.post-content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--space-6) 0;
}

.post-content table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-6) 0;
    font-size: var(--text-base);
}

.post-content th, .post-content td {
    padding: var(--space-3);
    border: 1px solid var(--border-color);
    text-align: left;
}

.post-content th {
    background-color: var(--bg-surface);
    font-weight: 600;
    color: var(--text-primary);
}

.post-content hr {
    border: none;
    border-top: 1px solid var(--border-color);
    margin: var(--space-10) 0;
}

/* Callout boxes */
.post-callout {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    margin: var(--space-6) 0;
    border-left: 4px solid;
}

.post-callout-info {
    background-color: rgba(0, 212, 255, 0.05);
    border-color: var(--color-accent);
}

.post-callout-warning {
    background-color: rgba(255, 170, 0, 0.05);
    border-color: var(--color-warning);
}

.post-callout-title {
    font-weight: 700;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
}

/* Share Section */
.post-share {
    padding: var(--space-8) 0;
    margin-top: var(--space-8);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
}

.post-share h4 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
}

.share-buttons {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
}

.share-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background-color: var(--bg-surface);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.share-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
}

.share-twitter:hover { color: #1DA1F2; border-color: #1DA1F2; }
.share-linkedin:hover { color: #0A66C2; border-color: #0A66C2; }

/* Citation */
.post-citation {
    padding: var(--space-6) 0;
    margin-top: var(--space-6);
}

.post-citation h4 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
}

.citation-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    position: relative;
}

.citation-box pre {
    background-color: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    white-space: pre-wrap;
    word-break: break-word;
}

.citation-copy {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-accent);
    color: var(--text-inverse);
    border: none;
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
}

.citation-copy:hover {
    background-color: var(--color-accent-hover);
}

/* Post Navigation */
.post-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-10);
}

.post-nav-item {
    padding: var(--space-5);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: all var(--transition-fast);
}

.post-nav-item:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
}

.post-nav-next {
    text-align: right;
}

.nav-direction {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-accent);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-2);
}

.nav-title {
    display: block;
    font-size: var(--text-base);
    color: var(--text-primary);
    font-weight: 600;
}

/* Comments */
.post-comments {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-color);
}

.post-comments h3 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
}

.comments-intro {
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
}

.giscus-placeholder {
    text-align: center;
    padding: var(--space-10) var(--space-6);
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-color);
    border-radius: var(--radius-lg);
}

.placeholder-icon {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-3);
}

.giscus-placeholder p {
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
}

.giscus-placeholder code {
    background-color: var(--code-bg);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
}

/* Sidebar */
.post-sidebar {
    position: relative;
}

.sidebar-sticky {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding-right: var(--space-2);
}

.sidebar-sticky::-webkit-scrollbar {
    width: 4px;
}

.sidebar-sticky::-webkit-scrollbar-thumb {
    background: var(--border-color);
    border-radius: 2px;
}

.sidebar-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
}

.sidebar-card h4 {
    font-size: var(--text-base);
    margin-bottom: var(--space-4);
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
}

/* TOC */
.toc {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
}

.toc-link {
    display: block;
    padding: var(--space-1) 0;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    border-left: 2px solid transparent;
    padding-left: var(--space-3);
    transition: all var(--transition-fast);
    line-height: 1.4;
}

.toc-link:hover {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
}

.toc-link.active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    font-weight: 600;
}

.toc-link.toc-h3 {
    padding-left: var(--space-6);
    font-size: var(--text-xs);
}

/* Author Card */
.author-card {
    text-align: center;
}

.author-card-avatar {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--color-accent), var(--color-secondary-accent));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-inverse);
    font-size: var(--text-xl);
    font-weight: 700;
    margin: 0 auto var(--space-3);
}

.author-card h4 {
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
}

.author-card-bio {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
}

.author-card-links {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
}

.author-card-links a {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background-color: var(--bg-body);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
}

.author-card-links a:hover {
    background-color: var(--color-accent);
    color: var(--text-inverse);
}

.author-card-links svg {
    width: 16px;
    height: 16px;
}

/* Related Posts */
.related-posts {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
}

.related-post-item {
    display: block;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color var(--transition-fast);
}

.related-post-item:hover {
    background-color: var(--bg-body);
}

.related-post-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-1);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.related-post-meta {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    font-family: var(--font-mono);
}

/* Newsletter Card */
.newsletter-card {
    background: linear-gradient(135deg, rgba(var(--color-accent-rgb), 0.05), rgba(var(--color-secondary-accent-rgb), 0.05));
    text-align: center;
}

.newsletter-card h4 {
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--text-lg);
}

.newsletter-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
}

/* Toast */
.toast {
    position: fixed;
    bottom: var(--space-6);
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background-color: var(--color-primary);
    color: var(--color-accent);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 500;
    box-shadow: var(--shadow-lg);
    z-index: 10000;
    opacity: 0;
    transition: all var(--transition-normal);
    pointer-events: none;
}

.toast.show {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
}

/* Responsive */
@media (max-width: 1024px) {
    .blog-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .post-layout {
        grid-template-columns: 1fr;
    }
    .post-sidebar {
        order: -1;
    }
    .sidebar-sticky {
        position: static;
        max-height: none;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-4);
    }
    .toc-card {
        grid-column: span 2;
    }
}

@media (max-width: 768px) {
    .blog-hero h1 {
        font-size: var(--text-4xl);
    }
    .blog-grid {
        grid-template-columns: 1fr;
    }
    .post-title {
        font-size: var(--text-3xl);
    }
    .post-content {
        font-size: var(--text-base);
    }
    .post-content h2 {
        font-size: var(--text-2xl);
    }
    .post-content h3 {
        font-size: var(--text-xl);
    }
    .sidebar-sticky {
        grid-template-columns: 1fr;
    }
    .toc-card {
        grid-column: span 1;
    }
    .post-navigation {
        grid-template-columns: 1fr;
    }
    .post-nav-next {
        text-align: left;
    }
    .blog-controls {
        position: static;
    }
}

@media (prefers-reduced-motion: reduce) {
    .reading-progress-bar,
    .blog-card,
    .share-btn,
    .post-nav-item,
    .toast {
        transition: none;
    }
}